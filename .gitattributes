# Keep pinned source/configuration hashes identical on Windows and Unix.
* text=auto eol=lf
*.png -text
*.ico -text
*.zip -text
# Preserve the exact upstream bytes recorded in the Windows source manifests.
third_party/weasel/** -text -whitespace
third_party/windows-runtime/** -text -whitespace
third_party/rime-double-pinyin/** -text -whitespace
